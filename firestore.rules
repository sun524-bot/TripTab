rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ----------------------------------------------------------------
    // Helper functions
    // ----------------------------------------------------------------
    function isAuth() {
      return request.auth != null;
    }

    function isUser(uid) {
      return isAuth() && request.auth.uid == uid;
    }

    // Helper for subcollection access to check parent trip membership
    function isParentTripMember(tripId) {
      return isAuth() &&
        request.auth.uid in get(/databases/$(database)/documents/trips/$(tripId)).data.memberUids;
    }

    function isParentTripAdmin(tripId) {
      return isAuth() &&
        get(/databases/$(database)/documents/trips/$(tripId)).data.members[request.auth.uid].role == 'admin';
    }

    // ----------------------------------------------------------------
    // Users collection
    // Can read/write own profile only
    // Others can read your name (for invite lookup)
    // ----------------------------------------------------------------
    match /users/{uid} {
      allow read: if isAuth();   // needed for invite-by-email lookup
      allow create: if isUser(uid);
      allow update: if isUser(uid);
      allow delete: if false;    // never delete users
    }

    // ----------------------------------------------------------------
    // Trips collection
    // ----------------------------------------------------------------
    match /trips/{tripId} {
      // Members or invited users can read their trip (enables array-contains queries)
      allow read: if isAuth() && (
        (resource.data.memberUids != null && request.auth.uid in resource.data.memberUids) ||
        (resource.data.pendingInvites != null && request.auth.token.email != null && request.auth.token.email in resource.data.pendingInvites)
      );

      // Any authenticated user can create a trip (they become admin)
      allow create: if isAuth()
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.members[request.auth.uid].role == 'admin';

      // Members can update (e.g. add expenses, invite members)
      allow update: if isAuth() && (
        request.auth.uid in resource.data.memberUids ||
        (resource.data.pendingInvites != null && request.auth.token.email != null && request.auth.token.email in resource.data.pendingInvites)
      );

      // Only admin can delete
      allow delete: if isAuth() && resource.data.members[request.auth.uid].role == 'admin';

      // ----------------------------------------------------------------
      // Expenses subcollection
      // ----------------------------------------------------------------
      match /expenses/{expenseId} {
        // Any trip member can read expenses
        allow read: if isParentTripMember(tripId);

        // Any trip member can add an expense
        allow create: if isParentTripMember(tripId);

        // Original adder OR admin can update/delete
        allow update: if isParentTripMember(tripId)
          && (resource.data.paidBy == request.auth.uid || resource.data.addedBy == request.auth.uid || isParentTripAdmin(tripId));

        allow delete: if isParentTripMember(tripId)
          && (resource.data.paidBy == request.auth.uid || resource.data.addedBy == request.auth.uid || isParentTripAdmin(tripId));
      }

      // ----------------------------------------------------------------
      // Settlements subcollection
      // ----------------------------------------------------------------
      match /settlements/{settlementId} {
        // Any trip member can read settlements
        allow read: if isParentTripMember(tripId);

        // Trip member can mark their own payment as settled
        allow create: if isParentTripMember(tripId);

        // Allow update by trip member
        allow update: if isParentTripMember(tripId);

        allow delete: if isParentTripMember(tripId);
      }
    }
  }
}
